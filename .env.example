# Flags de funcionalidades (padrão: desligadas). Use "true" para ligar. Ver PENDENCIAS.md.
# Categorias/subitens em RASCUNHO (aguardam validação da cliente): páginas /categoria/<slug>
MOSTRAR_RASCUNHO_SUBITENS=false
# "Soluções personalizadas" em etiquetas coloridas (exige MOSTRAR_RASCUNHO_SUBITENS=true)
SECAO_SOLUCOES_CHIPS=false
# Formulário /enviar-receita (exige RECEITA_DESTINO)
RECEITA_FORM_ENABLED=false
# Destino do formulário. "local" grava em .data/receitas/ (SÓ para teste; recusado em produção).
RECEITA_DESTINO=
# Seção YouTube/Instagram (exige URLs em videos, src/config/site.ts)
SECAO_VIDEOS=false
# Variação do pilar de personalização: a | b | (vazio = desligado)
PILAR_PERSONALIZACAO=
